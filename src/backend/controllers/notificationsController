const db = require("../config/db");

// Busca notificações de um usuário (respeitando preferências)
exports.getNotifications = (req, res) => {
  const { userId } = req.params;

  const sql = `
    SELECT n.id, n.type, n.title, n.message, n.read_at, n.created_at
    FROM notifications n
    INNER JOIN users u ON u.id = n.user_id
    WHERE n.user_id = ?
      AND (
        (n.type = 'collection_point' AND u.receive_notifications = TRUE)
        OR
        (n.type = 'newsletter'       AND u.receive_newsletter     = TRUE)
        OR
         n.type = 'welcome'
      )
    ORDER BY n.created_at DESC
    LIMIT 50
  `;

  db.query(sql, [userId], (err, results) => {
    if (err) return res.status(500).json({ error: "Erro ao buscar notificações" });
    res.json(results);
  });
};

// Marca uma notificação como lida
exports.markAsRead = (req, res) => {
  const { id } = req.params;

  db.query(
    "UPDATE notifications SET read_at = NOW() WHERE id = ?",
    [id],
    (err) => {
      if (err) return res.status(500).json({ error: "Erro ao marcar como lida" });
      res.json({ message: "Notificação marcada como lida" });
    }
  );
};

// Marca todas as notificações do usuário como lidas
exports.markAllAsRead = (req, res) => {
  const { userId } = req.params;

  db.query(
    "UPDATE notifications SET read_at = NOW() WHERE user_id = ? AND read_at IS NULL",
    [userId],
    (err) => {
      if (err) return res.status(500).json({ error: "Erro ao marcar notificações" });
      res.json({ message: "Todas as notificações marcadas como lidas" });
    }
  );
};

// Conta notificações não lidas (para badge no menu)
exports.getUnreadCount = (req, res) => {
  const { userId } = req.params;

  const sql = `
    SELECT COUNT(*) AS total
    FROM notifications n
    INNER JOIN users u ON u.id = n.user_id
    WHERE n.user_id = ?
      AND n.read_at IS NULL
      AND (
        (n.type = 'collection_point' AND u.receive_notifications = TRUE)
        OR
        (n.type = 'newsletter'       AND u.receive_newsletter     = TRUE)
        OR
         n.type = 'welcome'
      )
  `;

  db.query(sql, [userId], (err, results) => {
    if (err) return res.status(500).json({ error: "Erro ao contar notificações" });
    res.json({ unread: results[0].total });
  });
};

