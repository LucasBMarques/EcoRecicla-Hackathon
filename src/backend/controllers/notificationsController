// Disparado no register: boas-vindas + primeira newsletter
exports.createWelcomeNotifications = (userId) => {
  const notifications = [
    {
      user_id: userId,
      type: "welcome",
      title: "🌱 Bem-vindo(a) ao EcoRecicla!",
      message:
        "Sua conta foi criada com sucesso. Comece registrando sua primeira reciclagem e acumule pontos eco!",
    },
    {
      user_id: userId,
      type: "newsletter",
      title: "📰 Boletim EcoRecicla — Edição de Boas-Vindas",
      message:
        "Você sabia que reciclar 1 kg de alumínio economiza até 5 kWh de energia? Cada grama que você recicla conta! Explore o mapa de pontos de coleta e comece hoje mesmo.",
    },
  ];

  notifications.forEach(({ user_id, type, title, message }) => {
